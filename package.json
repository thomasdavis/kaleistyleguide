    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "lint": "eslint src --ext js,jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,scss,css}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
