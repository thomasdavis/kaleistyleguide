{
  "preset": "ts-jest",
  "testEnvironment": "jsdom",
  "moduleNameMapper": {
    "\\.(css|less|scss|sass)$": "identity-obj-proxy",
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
  "transform": {
    "^.+\\.(js|jsx)$": "babel-jest"
  },
  "extensionsToTreatAsEsm": [".jsx"],
  "testMatch": ["**/__tests__/**/*.test.(js|jsx)"]
}